// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://ai:ai@localhost:5532/formx_platform"

}

model Finish {
  id            String   @id @default(cuid())
  name          String
  type          String
  costPerSqIn   Float
  leadTimeDays  Int
  description   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  parts         Part[]
  routings      Routing[]
  
  // Audit
  createdBy     String
  version       Int      @default(1)
  
  @@index([type])
  @@index([active])
}

model Material {
  id            String   @id @default(cuid())
  name          String
  cost          Float
  markup        Float
  density       Float
  unit          String
  processes     Process[]
  active        Boolean  @default(true)
  
  // Relations
  parts         Part[]
  
  // Audit & versioning
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String
  
  @@index([active])
}

model Process {
  id                 String   @id @default(cuid())
  name               String
  setupTime          Int      // minutes
  hourlyRate         Float
  minimumCost        Float
  complexityMultiplier Float
  active             Boolean  @default(true)
  category           String
  
  // Relations
  materials         Material[]
  routingSteps      RoutingStep[]
  parts             Part[]
  
  // Audit
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String
  
  @@index([category])
  @@index([active])
}

model Routing {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  category            String
  steps               RoutingStep[]
  totalSetupTime      Int
  estimatedLeadTime   Int
  active              Boolean  @default(true)
  materialMarkup      Float
  finishingCost      Float
  isPrimaryPricingRoute Boolean @default(false)
  
  // Relations
  finish             Finish?  @relation(fields: [finishId], references: [id])
  finishId           String?
  parts              Part[]
  
  // Audit
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String
  
  @@index([category])
  @@index([active])
}

model RoutingStep {
  id                 String   @id @default(cuid())
  processId          String
  processName        String
  sequence           Int
  setupTimeMultiplier Float
  runtimeMultiplier  Float
  notes              String?
  setupTime          Int
  hourlyRate         Float
  minimumCost        Float
  complexityMultiplier Float
  
  // Relations
  routing           Routing  @relation(fields: [routingId], references: [id], onDelete: Cascade)
  routingId         String
  process           Process  @relation(fields: [processId], references: [id])
  
  // Audit
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String
  
  @@index([routingId])
  @@index([processId])
  @@index([sequence])
}

// Pricing Models
model PricingConfiguration {
  id                String   @id @default(cuid())
  routings          RoutingPricing[]
  defaultTierMultipliers Json      // Stored as JSON: { economy: number, standard: number, rush: number }
  volumeBreaks      Json      // Stored as JSON array of VolumeBreak objects
  minimumOrderValue Float
  
  // Audit
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String
  status           String   @default("draft") // draft, published, archived
  
  @@index([status])
}

model FeatureFlag {
  id                String   @id @default(cuid())
  name              String
  description       String
  enabled           Boolean
  rolloutPercentage Int
  category          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


model RoutingPricing {
  id                 String   @id @default(cuid())
  routingId          String
  routingName        String
  category           String
  baseCost           Float
  materialMarkup     Float
  finishingCost      Float
  leadTime           Int
  tierOverrides      Json?    // Stored as JSON for flexibility
  
  // Relations
  configuration     PricingConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  configurationId   String
  
  // Audit
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String
  
  @@index([category])
  @@index([configurationId])
}

// Part Data Model
model Part {
  id            String   @id @default(cuid())
  partName      String
  quantity      Int
  tolerance     String
  fileName      String
  fileSize      Int
  fileType      String
  fileUrl       String?
  
  // Relations
  process       Process  @relation(fields: [processId], references: [id])
  processId     String
  material      Material @relation(fields: [materialId], references: [id])
  materialId    String
  finish        Finish?  @relation(fields: [finishId], references: [id])
  finishId      String?
  routing       Routing? @relation(fields: [routingId], references: [id])
  routingId     String?
  
  // Audit
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String
  
  @@index([processId])
  @@index([materialId])
  @@index([finishId])
}

// User Management
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          String
  permissions   Json     // Stored as JSON array of permission strings
  password      String   // Hashed password
  disabled      Boolean  @default(false)
  
  // Audit
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLogin     DateTime?
  
  @@index([email])
  @@index([role])
}

// Audit Log
model AuditLog {
  id            String   @id @default(cuid())
  action        String   // create, update, delete
  entityType    String   // The model name (Finish, Material, etc.)
  entityId      String   // The ID of the affected record
  changes       Json     // The actual changes made
  userId        String   // Who made the change
  timestamp     DateTime @default(now())
  metadata      Json?    // Additional context (client IP, user agent, etc.)
  
  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId])
}

// Migration Backup for rollback capability
model MigrationBackup {
  id            String   @id @default(cuid())
  name          String   @unique
  data          Json     // Backup data
  timestamp     DateTime @default(now())
  
  @@index([name])
  @@index([timestamp])
}