generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://ai:ai@localhost:5532/formx_platform"
}

model Finish {
  id           String    @id @default(cuid())
  name         String
  type         String
  costPerSqIn  Float
  leadTimeDays Int
  description  String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String
  version      Int       @default(1)
  parts        Part[]
  routings     Routing[]

  @@index([type])
  @@index([active])
}

model Material {
  id        String    @id @default(cuid())
  name      String
  cost      Float
  markup    Float
  density   Float
  unit      String
  active    Boolean   @default(true)
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  parts     Part[]
  processes Process[] @relation("MaterialToProcess")

  @@index([active])
}

model Process {
  id                   String        @id @default(cuid())
  name                 String
  setupTime            Int
  hourlyRate           Float
  minimumCost          Float
  complexityMultiplier Float
  active               Boolean       @default(true)
  category             String
  version              Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            String
  parts                Part[]
  routingSteps         RoutingStep[]
  materials            Material[]    @relation("MaterialToProcess")

  @@index([category])
  @@index([active])
}

model Routing {
  id                    String           @id @default(cuid())
  name                  String
  description           String?
  category              String
  totalSetupTime        Int
  estimatedLeadTime     Int
  active                Boolean          @default(true)
  materialMarkup        Float
  finishingCost         Float
  isPrimaryPricingRoute Boolean          @default(false)
  finishId              String?
  version               Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdBy             String
  parts                 Part[]
  finish                Finish?          @relation(fields: [finishId], references: [id])
  routingPricing        RoutingPricing[]
  steps                 RoutingStep[]

  @@index([category])
  @@index([active])
}

model RoutingStep {
  id                   String   @id @default(cuid())
  processId            String
  processName          String
  sequence             Int
  setupTimeMultiplier  Float
  runtimeMultiplier    Float
  notes                String?
  setupTime            Int
  hourlyRate           Float
  minimumCost          Float
  complexityMultiplier Float
  routingId            String
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String
  process              Process  @relation(fields: [processId], references: [id])
  routing              Routing  @relation(fields: [routingId], references: [id], onDelete: Cascade)

  @@index([routingId])
  @@index([processId])
  @@index([sequence])
}

model PricingConfiguration {
  id                     String           @id @default(cuid())
  defaultTierMultipliers Json
  volumeBreaks           Json
  minimumOrderValue      Float
  version                Int              @default(1)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  createdBy              String
  status                 String           @default("draft")
  routings               RoutingPricing[]

  @@index([status])
}

model FeatureFlag {
  id                String   @id @default(cuid())
  name              String
  description       String
  enabled           Boolean
  rolloutPercentage Int
  category          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RoutingPricing {
  id                    String               @id @default(cuid())
  routingId             String
  category              String
  baseCost              Float
  materialMarkup        Float
  finishingCost         Float
  leadTime              Int
  tierOverrides         Json?
  configurationId       String
  version               Int                  @default(1)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdBy             String
  isBaseCostOverridden  Boolean              @default(false)
  isFinishingOverridden Boolean              @default(false)
  isLeadTimeOverridden  Boolean              @default(false)
  isMarkupOverridden    Boolean              @default(false)
  configuration         PricingConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  routing               Routing              @relation(fields: [routingId], references: [id], onDelete: Cascade)

  @@unique([routingId, configurationId])
  @@index([category])
  @@index([configurationId])
  @@index([routingId])
}

model Part {
  id         String      @id @default(cuid())
  partName   String
  quantity   Int
  tolerance  String
  fileName   String
  fileSize   Int
  fileType   String
  fileUrl    String?
  processId  String
  materialId String
  finishId   String?
  routingId  String?
  version    Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  createdBy  String
  finish     Finish?     @relation(fields: [finishId], references: [id])
  material   Material    @relation(fields: [materialId], references: [id])
  process    Process     @relation(fields: [processId], references: [id])
  routing    Routing?    @relation(fields: [routingId], references: [id])
  rfqParts   RFQPart[]
  quoteParts QuotePart[]
  orderParts OrderPart[]
  cartItems  CartItem[]

  @@index([processId])
  @@index([materialId])
  @@index([finishId])
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String
  role        String
  permissions Json
  password    String
  disabled    Boolean    @default(false)
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastLogin   DateTime?
  customer    Customer?  @relation("UserCustomer")

  @@index([email])
  @@index([role])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  changes    Json
  userId     String
  timestamp  DateTime @default(now())
  metadata   Json?

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId])
}

model MigrationBackup {
  id        String   @id @default(cuid())
  name      String   @unique
  data      Json
  timestamp DateTime @default(now())

  @@index([name])
  @@index([timestamp])
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?
  company        String?
  customerSince  DateTime @default(now())
  paymentStatus  String   @default("Good Standing")
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String
  userId         String?  @unique
  user           User?    @relation("UserCustomer", fields: [userId], references: [id])
  rfqs           RFQ[]
  quotes         Quote[]
  orders         Order[]

  @@index([email])
  @@index([company])
  @@index([active])
  @@index([userId])
}

model File {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  fileUrl      String
  uploadedBy   String
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rfqs         RFQ[]    @relation("RFQFiles")
  quotes       Quote[]  @relation("QuoteFiles")
  orders       Order[]  @relation("OrderFiles")

  @@index([uploadedBy])
  @@index([mimeType])
}

model RFQ {
  id               String      @id @default(cuid())
  rfqNumber        String      @unique
  customerId       String
  submittedDate    DateTime    @default(now())
  status           String      @default("Draft") // Draft, Submitted, In Review, Quoted, Rejected
  customerNotes    String?
  internalNotes    Json?       // Array of note objects
  estimatedCost    Float?
  version          Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdBy        String
  customer         Customer    @relation(fields: [customerId], references: [id])
  parts            RFQPart[]
  files            File[]      @relation("RFQFiles")
  quotes           Quote[]

  @@index([customerId])
  @@index([status])
  @@index([submittedDate])
  @@index([rfqNumber])
}

model RFQPart {
  id        String   @id @default(cuid())
  rfqId     String
  partId    String
  quantity  Int
  tolerance String
  leadTime  String   // Standard, Expedited, Rush
  notes     String?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  part      Part     @relation(fields: [partId], references: [id])

  @@index([rfqId])
  @@index([partId])
}

model Quote {
  id               String      @id @default(cuid())
  quoteNumber      String      @unique
  rfqId            String
  customerId       String
  status           String      @default("Draft") // Draft, Sent, Approved, Rejected, Expired
  subtotal         Float
  discounts        Float       @default(0)
  total            Float
  tier             String      // economy, standard, rush
  validUntil       DateTime
  sentDate         DateTime?
  approvedDate     DateTime?
  rejectedDate     DateTime?
  rejectionReason  String?
  internalNotes    Json?
  breakdown        Json        // Detailed pricing breakdown
  version          Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdBy        String
  rfq              RFQ         @relation(fields: [rfqId], references: [id])
  customer         Customer    @relation(fields: [customerId], references: [id])
  parts            QuotePart[]
  files            File[]      @relation("QuoteFiles")
  orders           Order[]

  @@index([customerId])
  @@index([rfqId])
  @@index([status])
  @@index([quoteNumber])
  @@index([validUntil])
}

model QuotePart {
  id                  String   @id @default(cuid())
  quoteId             String
  partId              String
  quantity            Int
  basePrice           Float
  materialCost        Float
  finishingCost       Float
  multiplier          Float
  discountPercent     Float
  discountAmount      Float
  finalPricePerUnit   Float
  totalPrice          Float
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String
  quote               Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  part                Part     @relation(fields: [partId], references: [id])

  @@index([quoteId])
  @@index([partId])
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  quoteId          String?
  customerId       String
  status           String        @default("Pending") // Pending, In Production, Shipped, Completed, Cancelled
  subtotal         Float
  tax              Float         @default(0)
  shipping         Float         @default(0)
  total            Float
  orderDate        DateTime      @default(now())
  estimatedShipDate DateTime?
  actualShipDate   DateTime?
  trackingNumber   String?
  customerNotes    String?
  internalNotes    Json?
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        String
  quote            Quote?        @relation(fields: [quoteId], references: [id])
  customer         Customer      @relation(fields: [customerId], references: [id])
  parts            OrderPart[]
  files            File[]        @relation("OrderFiles")

  @@index([customerId])
  @@index([quoteId])
  @@index([status])
  @@index([orderNumber])
  @@index([orderDate])
}

model OrderPart {
  id             String   @id @default(cuid())
  orderId        String
  partId         String
  quantity       Int
  unitPrice      Float
  totalPrice     Float
  status         String   @default("Pending") // Pending, In Production, Completed, Shipped
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part           Part     @relation(fields: [partId], references: [id])

  @@index([orderId])
  @@index([partId])
  @@index([status])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String     // User who owns the cart
  customerId String?    // Linked customer (for user-customer mapping)
  sessionId  String?    // For guest users
  active     Boolean    @default(true)
  version    Int        @default(1)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([userId])
  @@index([customerId])
  @@index([sessionId])
  @@index([active])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  partId     String
  quantity   Int
  tolerance  String   @default("Standard")
  leadTime   String   @default("Standard")
  notes      String?
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  part       Part     @relation(fields: [partId], references: [id])

  @@unique([cartId, partId]) // Prevent duplicate parts in same cart
  @@index([cartId])
  @@index([partId])
}
