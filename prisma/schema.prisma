generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://ai:ai@localhost:5532/formx_platform"
}

model Finish {
  id           String    @id @default(cuid())
  name         String
  type         String
  costPerSqIn  Float
  leadTimeDays Int
  description  String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String
  version      Int       @default(1)
  parts        Part[]
  routings     Routing[]

  @@index([type])
  @@index([active])
}

model Material {
  id        String    @id @default(cuid())
  name      String
  cost      Float
  markup    Float
  density   Float
  unit      String
  active    Boolean   @default(true)
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  parts     Part[]
  processes Process[] @relation("MaterialToProcess")

  @@index([active])
}

model Process {
  id                   String        @id @default(cuid())
  name                 String
  setupTime            Int
  hourlyRate           Float
  minimumCost          Float
  complexityMultiplier Float
  active               Boolean       @default(true)
  category             String
  version              Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            String
  parts                Part[]
  routingSteps         RoutingStep[]
  materials            Material[]    @relation("MaterialToProcess")

  @@index([category])
  @@index([active])
}

model Routing {
  id                    String           @id @default(cuid())
  name                  String
  description           String?
  category              String
  totalSetupTime        Int
  estimatedLeadTime     Int
  active                Boolean          @default(true)
  materialMarkup        Float
  finishingCost         Float
  isPrimaryPricingRoute Boolean          @default(false)
  finishId              String?
  version               Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdBy             String
  parts                 Part[]
  finish                Finish?          @relation(fields: [finishId], references: [id])
  routingPricing        RoutingPricing[]
  steps                 RoutingStep[]

  @@index([category])
  @@index([active])
}

model RoutingStep {
  id                   String   @id @default(cuid())
  processId            String
  processName          String
  sequence             Int
  setupTimeMultiplier  Float
  runtimeMultiplier    Float
  notes                String?
  setupTime            Int
  hourlyRate           Float
  minimumCost          Float
  complexityMultiplier Float
  routingId            String
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String
  process              Process  @relation(fields: [processId], references: [id])
  routing              Routing  @relation(fields: [routingId], references: [id], onDelete: Cascade)

  @@index([routingId])
  @@index([processId])
  @@index([sequence])
}

model PricingConfiguration {
  id                     String           @id @default(cuid())
  defaultTierMultipliers Json
  volumeBreaks           Json
  minimumOrderValue      Float
  version                Int              @default(1)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  createdBy              String
  status                 String           @default("draft")
  routings               RoutingPricing[]

  @@index([status])
}

model FeatureFlag {
  id                String   @id @default(cuid())
  name              String
  description       String
  enabled           Boolean
  rolloutPercentage Int
  category          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RoutingPricing {
  id                    String               @id @default(cuid())
  routingId             String
  category              String
  baseCost              Float
  materialMarkup        Float
  finishingCost         Float
  leadTime              Int
  tierOverrides         Json?
  configurationId       String
  version               Int                  @default(1)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdBy             String
  isBaseCostOverridden  Boolean              @default(false)
  isFinishingOverridden Boolean              @default(false)
  isLeadTimeOverridden  Boolean              @default(false)
  isMarkupOverridden    Boolean              @default(false)
  configuration         PricingConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  routing               Routing              @relation(fields: [routingId], references: [id], onDelete: Cascade)

  @@unique([routingId, configurationId])
  @@index([category])
  @@index([configurationId])
  @@index([routingId])
}

model Part {
  id         String   @id @default(cuid())
  partName   String
  quantity   Int
  tolerance  String
  fileName   String
  fileSize   Int
  fileType   String
  fileUrl    String?
  processId  String
  materialId String
  finishId   String?
  routingId  String?
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  finish     Finish?  @relation(fields: [finishId], references: [id])
  material   Material @relation(fields: [materialId], references: [id])
  process    Process  @relation(fields: [processId], references: [id])
  routing    Routing? @relation(fields: [routingId], references: [id])

  @@index([processId])
  @@index([materialId])
  @@index([finishId])
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        String
  permissions Json
  password    String
  disabled    Boolean   @default(false)
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLogin   DateTime?

  @@index([email])
  @@index([role])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  changes    Json
  userId     String
  timestamp  DateTime @default(now())
  metadata   Json?

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId])
}

model MigrationBackup {
  id        String   @id @default(cuid())
  name      String   @unique
  data      Json
  timestamp DateTime @default(now())

  @@index([name])
  @@index([timestamp])
}
